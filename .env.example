# The real domain, no trailing slash. Other hosts (vercel.app, previews) get noindex.
NEXT_PUBLIC_SITE_URL=https://example.com

# Search engine verification codes (leave empty to output nothing).
# Google Search Console: the content value of the google-site-verification meta tag.
NEXT_PUBLIC_GOOGLE_VERIFICATION=
# Bing Webmaster Tools: the content value of the msvalidate.01 meta tag.
NEXT_PUBLIC_BING_VERIFICATION=

# IndexNow key (8-128 letters, digits or dashes). Written to public/<key>.txt at build;
# "npm run indexnow" submits the sitemap after a deploy.
INDEXNOW_KEY=
